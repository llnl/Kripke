#ifndef KRIPKE_CONFIG_H__
#define KRIPKE_CONFIG_H__

#cmakedefine KRIPKE_VERSION "@KRIPKE_VERSION@"

#cmakedefine KRIPKE_CXX_COMPILER "@KRIPKE_CXX_COMPILER@"
#cmakedefine KRIPKE_CXX_FLAGS "@KRIPKE_CXX_FLAGS@"
#cmakedefine KRIPKE_LINK_FLAGS "@KRIPKE_LINK_FLAGS@"

#cmakedefine KRIPKE_USE_MPI
#cmakedefine KRIPKE_USE_OPENMP
#cmakedefine KRIPKE_USE_CUDA
#cmakedefine KRIPKE_USE_CHAI
#cmakedefine KRIPKE_USE_UMPIRE
#cmakedefine KRIPKE_USE_GPU_AWARE_MPI
#cmakedefine KRIPKE_USE_HIP
#cmakedefine KRIPKE_USE_DIRECT_UMPIRE_PLANE_STORAGE

#ifdef KRIPKE_USE_GPU_AWARE_MPI
#if !defined(KRIPKE_USE_CHAI) && !defined(KRIPKE_USE_UMPIRE)
#error "KRIPKE_USE_GPU_AWARE_MPI requires KRIPKE_USE_CHAI or KRIPKE_USE_UMPIRE"
#endif

#if !defined(KRIPKE_USE_CUDA) && !defined(KRIPKE_USE_HIP)
#error "KRIPKE_USE_GPU_AWARE_MPI requires KRIPKE_USE_CUDA or KRIPKE_USE_HIP"
#endif
#endif

#ifdef KRIPKE_USE_DIRECT_UMPIRE_PLANE_STORAGE
#ifndef KRIPKE_USE_GPU_AWARE_MPI
#error "KRIPKE_USE_DIRECT_UMPIRE_PLANE_STORAGE requires KRIPKE_USE_GPU_AWARE_MPI"
#endif

#if !defined(KRIPKE_USE_CHAI) && !defined(KRIPKE_USE_UMPIRE)
#error "KRIPKE_USE_DIRECT_UMPIRE_PLANE_STORAGE requires KRIPKE_USE_CHAI or KRIPKE_USE_UMPIRE"
#endif

#if !defined(KRIPKE_USE_CUDA) && !defined(KRIPKE_USE_HIP)
#error "KRIPKE_USE_DIRECT_UMPIRE_PLANE_STORAGE requires KRIPKE_USE_CUDA or KRIPKE_USE_HIP"
#endif
#endif

#cmakedefine KRIPKE_USE_CALIPER

#cmakedefine KRIPKE_ARCH "@KRIPKE_ARCH@"

#cmakedefine KRIPKE_ARCHV_DEFAULT @KRIPKE_ARCHV_DEFAULT@
#cmakedefine KRIPKE_LAYOUTV_DEFAULT @KRIPKE_LAYOUTV_DEFAULT@

#cmakedefine KRIPKE_NVCC_COMPILER "@KRIPKE_NVCC_COMPILER@"
#cmakedefine KRIPKE_NVCC_FLAGS "@KRIPKE_NVCC_FLAGS@"

#endif
